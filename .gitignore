# ============================================================
# Unity 工程版本控制标准忽略规则
# 适用于仓库内所有 Unity 工程（VolumeRenderingSample、VolumeRendering_2022、
# UnityVolumeRendering/SampleProject~ 等），因此规则不限定目录层级。
# ============================================================

# Unity 生成的目录（Library/Temp/Obj/Logs/Build/UserSettings 等）
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Unity 生成的 IDE 工程文件（打开工程后会自动重新生成）
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.VC.VC.opendb
*.unityproj

# IDE
.idea/
.vs/
*.vsh.sln
*.vsh.csproj

# 崩溃报告
sysinfo.txt

# 本仓库工具/临时文件（不参与版本控制）
.zcode/
unity6_compile_check.log

# folder_viewer/：WebGL 影像查看器分析输入（其中 STL 与 StreamingAssets/STL 重复，约 277MB），不入库
folder_viewer/
